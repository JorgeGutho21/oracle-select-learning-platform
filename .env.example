# DB LAB — variables de entorno (plantilla sin valores).
# Copia este archivo como .env.local y complétalo. Nunca subas .env.local ni claves al
# repositorio: .gitignore y .vercelignore los excluyen. Clasificación de cada variable y
# producción: docs/PRODUCTION_SETUP.md. Sala en vivo: docs/SUPABASE_SETUP.md.

# --- URL pública (QR y enlaces) ----------------------------------------------------------
# Dirección publicada de la plataforma, por ejemplo la de producción. Si falta, en Vercel
# se usa el dominio de producción del proyecto (despliegues de producción) o
# NEXT_PUBLIC_VERCEL_URL (vistas previas) y, en desarrollo, el origen de la página.
# No uses 127.0.0.1 ni localhost en producción: los móviles no podrían abrir el QR.
NEXT_PUBLIC_SITE_URL=

# --- Sala en vivo: acceso del profesor (solo servidor) -----------------------------------
# Clave que el profesor escribe en /presenter para crear salas. Sin ella no se crean salas.
PRESENTER_ACCESS_CODE=

# --- Sala en vivo: almacenamiento ---------------------------------------------------------
# «supabase» (por defecto si hay URL y clave de servicio) o «memory» (solo desarrollo y
# pruebas en un único proceso: los datos se pierden al reiniciar).
CLASSROOM_BACKEND=

# Proyecto Supabase: URL y clave secreta (sb_secret_…). SOLO SERVIDOR: nunca con prefijo
# NEXT_PUBLIC_. En proyectos con claves antiguas sirve SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cuentas de DB LAB y aviso en tiempo real de la sala. La clave publishable (sb_publishable_…)
# es pública por diseño: RLS decide qué ve cada sesión y no abre ninguna tabla ni función de
# la sala. En proyectos antiguos sirve NEXT_PUBLIC_SUPABASE_ANON_KEY. Una clave secreta puesta
# aquí por error se rechaza y nunca se entrega al navegador.
# - Cuentas (Fase 2): el servidor las lee al servir cada petición; requieren la migración
#   20261002120000_learner_accounts.sql. Sin ellas, la plataforma funciona como invitado.
# - Sala: sin ellas, las pantallas consultan la sala cada pocos segundos.
# Microsoft, plantillas de correo, SMTP y dominios institucionales se configuran en Supabase,
# no aquí (docs/AUTH_ARCHITECTURE.md, apartado 12). El rol de profesor se asigna con
# scripts/assign-role.mjs, que usa SUPABASE_URL y SUPABASE_SECRET_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Oracle real: laboratorio y calificación de M10 (solo servidor) ------------------------
# Cuenta LECTORA del laboratorio (nunca SYS, SYSTEM ni ADMIN). Guía: docs/ORACLE_SETUP.md.
# Sin estas tres variables el laboratorio informa «Oracle no conectado» y no simula nada.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
# Opcionales: esquema propietario de EMPLEADOS, tamaño del grupo, cola y plazo total (ms).
ORACLE_SCHEMA=
ORACLE_POOL_MAX=
ORACLE_QUEUE_MAX=
ORACLE_TIMEOUT_MS=
# Autonomous Database con mTLS (Oracle Cloud): ewallet.pem de la cartera en base64 (una sola
# línea) y la contraseña de la cartera, siempre juntas. `node scripts/oracle-cloud.mjs setup`
# las genera en .env.oracle.local como ORACLE_CLOUD_*.
ORACLE_WALLET_PEM_BASE64=
ORACLE_WALLET_PASSWORD=

# --- Pruebas con un Supabase de PRUEBA (nunca el de producción) --------------------------
# tests/integration/accounts-supabase.test.ts y tests/e2e/accounts.spec.ts. Con `supabase
# start`, los valores locales los imprime `supabase status`.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SECRET_KEY=
E2E_MAILPIT_URL=
